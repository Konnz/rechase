# /opt/rechase/.env auf dem VPS (nur für den Nutzer rechase lesbar). Nie ins Repo.
APP_IMAGE=ghcr.io/konnz/rechase
# Setzt update.sh bei jedem Deploy auf den Commit-SHA.
APP_TAG=latest
# Muss zu proxy_pass in der nginx-Seite passen.
APP_HOST_PORT=3150
# App-eigene Werte und Geheimnisse: noch keine (kommen mit dem Backend in R2).

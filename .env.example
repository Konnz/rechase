# /opt/rechase/.env auf dem VPS (nur für den Nutzer rechase lesbar). Nie ins Repo.
APP_IMAGE=ghcr.io/konnz/rechase
# Setzt update.sh bei jedem Deploy auf den Commit-SHA.
APP_TAG=latest
# Muss zu proxy_pass in der nginx-Seite passen.
APP_HOST_PORT=3150
# App-eigene Werte und Geheimnisse:
# PIN-Sperre, solange die App in Entwicklung ist (nur Ziffern empfohlen).
APP_PIN=
# Anmeldung mit Google (optional). Ohne beide Werte gibt es nur E-Mail und Passwort.
# Google Cloud Console → APIs & Dienste → Anmeldedaten → OAuth-Client-ID (Webanwendung),
# autorisierte Weiterleitungs-URI: https://rechase.konnerths.de/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Öffentliche Adresse für die Rückleitung von Google (optional, sonst aus dem Host-Header)
PUBLIC_URL=https://rechase.konnerths.de
# Adminbereich unter /admin: Konten mit diesen E-Mail-Adressen (kommagetrennt) sind Admin.
ADMIN_EMAILS=
